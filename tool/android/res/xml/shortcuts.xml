<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Add expense" and "Add income". MainActivity
     reads the "pockettally_action" extra. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_expense"
        android:shortcutId="add_expense"
        android:shortcutLongLabel="@string/shortcut_add_expense"
        android:shortcutShortLabel="@string/shortcut_add_expense">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.lumio.pockettally.MainActivity"
            android:targetPackage="com.lumio.pockettally">
            <extra android:name="pockettally_action" android:value="expense" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_income"
        android:shortcutId="add_income"
        android:shortcutLongLabel="@string/shortcut_add_income"
        android:shortcutShortLabel="@string/shortcut_add_income">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.lumio.pockettally.MainActivity"
            android:targetPackage="com.lumio.pockettally">
            <extra android:name="pockettally_action" android:value="income" />
        </intent>
    </shortcut>
</shortcuts>
